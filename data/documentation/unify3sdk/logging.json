{"metadata":{"modules":[{"name":"Unify3Sdk"}],"role":"article","roleHeading":"Article","title":"Logging"},"seeAlsoSections":[{"identifiers":["doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/GettingStarted","doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/TestContexts","doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/PerformingCalibration"],"generated":true,"title":"Articles","anchor":"Articles"}],"variants":[{"paths":["\/documentation\/unify3sdk\/logging"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/Logging","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk"]]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"codeVoice","code":"Unify3Sdk"},{"type":"text","text":" exposes a small logging API that lets your app choose which entries to receive and then observe them as they are emitted. The main APIs are "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/Unify\/setLogLevels(minLevel:maxLevel:)"},{"type":"text","text":" for filtering and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/Unify\/getLogs()"},{"type":"text","text":" for consuming "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/Log"},{"type":"text","text":" values."}],"type":"paragraph"},{"text":"Choose the log levels you want","level":2,"type":"heading","anchor":"Choose-the-log-levels-you-want"},{"inlineContent":[{"type":"text","text":"Call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/Unify\/setLogLevels(minLevel:maxLevel:)"},{"type":"text","text":" to define the inclusive range of log entries your app wants to receive."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let unify = Unify.shared","","try unify.setLogLevels(minLevel: .info, maxLevel: .error)"]},{"inlineContent":[{"type":"text","text":"That example requests:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/info"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/warn"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/error"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"It excludes lower-volume diagnostic entries such as "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/trace"},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/debug","isActive":true},{"type":"text","text":", and it also excludes "},{"type":"reference","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/fatal","isActive":true},{"type":"text","text":" because it is above the chosen maximum."}],"type":"paragraph"},{"inlineContent":[{"text":"The available levels are:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/trace"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/debug"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/info"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/warn"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/error"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/fatal"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"In practice:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"use a wider range such as "},{"type":"codeVoice","code":".trace"},{"type":"text","text":" through "},{"type":"codeVoice","code":".fatal"},{"type":"text","text":" when you need maximum diagnostic detail"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"use a narrower range such as ","type":"text"},{"code":".info","type":"codeVoice"},{"text":" through ","type":"text"},{"code":".error","type":"codeVoice"},{"type":"text","text":" for a quieter app-facing log view"}],"type":"paragraph"}]}]},{"type":"heading","text":"Read and print the logs","anchor":"Read-and-print-the-logs","level":2},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/Unify\/getLogs()"},{"text":" returns an ","type":"text"},{"type":"codeVoice","code":"AsyncThrowingStream"},{"text":" of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/Log"},{"text":" entries. Start a task that iterates over that stream and formats each entry however your app wants to display it.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let unify = Unify.shared","","try unify.setLogLevels(minLevel: .info, maxLevel: .error)","","let logTask = Task {","    let formatter = ISO8601DateFormatter()","","    do {","        for try await log in unify.getLogs() {","            let timestamp = formatter.string(from: log.time)","            print(\"[\\(timestamp)] [\\(log.level)] [\\(log.logger)] \\(log.message)\")","        }","    } catch {","        print(\"Log stream failed: \\(error)\")","    }","}"]},{"inlineContent":[{"text":"Each ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/Log"},{"text":" contains:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"time","type":"codeVoice"},{"type":"text","text":", the timestamp for that entry"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"level","type":"codeVoice"},{"type":"text","text":", the log severity as "},{"type":"reference","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"logger","type":"codeVoice"},{"type":"text","text":", the name of the logger that produced the entry"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"message","type":"codeVoice"},{"type":"text","text":", the human-readable message text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Because the log API is a stream, it fits naturally alongside other long-running SDK flows. For example, an app can start log collection during setup and keep that task alive while it scans, connects, configures tests, and runs measurements.","type":"text"}],"type":"paragraph"},{"text":"Stop consuming the stream","level":2,"type":"heading","anchor":"Stop-consuming-the-stream"},{"inlineContent":[{"text":"Log collection continues until the stream completes or your task is cancelled. When your app no longer needs logs, cancel the task that is iterating over ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/Unify\/getLogs()"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["logTask.cancel()"]},{"inlineContent":[{"type":"text","text":"If your app only needs temporary diagnostics around one workflow, this is usually the simplest lifecycle model: start the logging task, run the workflow, then cancel the task when you are done."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Configure log filtering and display the log stream.","type":"text"}],"sections":[],"references":{"doc://com.kaelus.unify3sdk/documentation/Unify3Sdk/LogLevel/debug":{"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/debug","role":"symbol","title":"LogLevel.debug","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"debug"}],"url":"\/documentation\/unify3sdk\/loglevel\/debug","abstract":[{"text":"Debug-level logging.","type":"text"}],"type":"topic","kind":"symbol"},"doc://com.kaelus.unify3sdk/documentation/Unify3Sdk/Log":{"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/Log","role":"symbol","title":"Log","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Log","kind":"identifier"}],"url":"\/documentation\/unify3sdk\/log","abstract":[{"text":"A log entry.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"Log","kind":"identifier"}],"kind":"symbol"},"doc://com.kaelus.unify3sdk/documentation/Unify3Sdk/LogLevel/error":{"identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/LogLevel\/error","role":"symbol","title":"LogLevel.error","fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"error"}],"url":"\/documentation\/unify3sdk\/loglevel\/error","abstract":[{"type":"text","text"