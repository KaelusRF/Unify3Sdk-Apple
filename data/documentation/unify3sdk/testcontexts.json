":"article","title":"Getting Started with Unify3Sdk","type":"topic","abstract":[{"text":"A walkthrough of the main Unify3Sdk workflow.","type":"text"}],"url":"\/documentation\/unify3sdk\/gettingstarted","kind":"article","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/GettingStarted"},"doc://com.kaelus.unify3sdk/documentation/Unify3Sdk/PerformingCalibration":{"type":"topic","role":"article","identifier":"doc:\/\/com.kaelus.unify3sdk\/documentation\/Unify3Sdk\/PerformingCalibration","url":"\/documentation\/unify3sdk\/performingcalibration","abstract":[{"text":"Configure and run an OSL calibration.","type":"text"}],"kind":"article","title":"Performing a Calibration"}}}